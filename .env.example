# ─── LOCAL DEVELOPMENT ONLY ───────────────────────────────────────────────
# On Railway, set these as service Variables instead — do NOT commit a real .env

SECRET_KEY=generate-with-the-command-in-README
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (Railway injects DATABASE_URL instead)
DB_NAME=auction_intel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Background execution mode.
#   False (default) - crawls run inline from the admin. No Redis needed.
#   True            - requires a broker below, plus worker and beat services.
USE_CELERY=False
# CELERY_BROKER_URL=redis://localhost:6379/0

# Crawler policy — put your real contact address in the user agent
CRAWLER_USER_AGENT=AuctionIntelBot/1.0 (Pennsylvania Real Estate Research; contact: your@email.com)
CRAWL_DELAY_SECONDS=5
MIN_HISTORICAL_SAMPLE=30

# Analysis thresholds
LOW_COMPETITION_MIN_BID_RATIO=0.40
LOW_COMPETITION_SCORE_THRESHOLD=70
MAX_RISK_SCORE=60

LOG_LEVEL=INFO
